# =============================================================================
# App Reviews Analysis System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Secret / host values are intentionally empty: set them in your own .env only.
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Python Environment
# -----------------------------------------------------------------------------
# Python 실행 경로 (conda, venv 등 사용 시 명시)
PYTHON_PATH=

# -----------------------------------------------------------------------------
# Flask Application
# -----------------------------------------------------------------------------
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5952
SECRET_KEY=

# JWT Configuration (Session 7: Authentication)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# -----------------------------------------------------------------------------
# Gunicorn (Production)
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=4

# -----------------------------------------------------------------------------
# Scheduler Database (MySQL)
# -----------------------------------------------------------------------------
SCHEDULER_DB_HOST=localhost
SCHEDULER_DB_PORT=3306
SCHEDULER_DB_USER=
SCHEDULER_DB_PASSWORD=
SCHEDULER_DB_NAME=app_reviews_scheduler

# -----------------------------------------------------------------------------
# MySQL Database
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=app_reviews_scheduler
MYSQL_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# OpenSearch Configuration
# -----------------------------------------------------------------------------
OPENSEARCH_HOSTS=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_SSL_VERIFY=false
OPENSEARCH_INDEX_REVIEWS=app_reviews
OPENSEARCH_INDEX_ANALYTICS=review_analytics

# -----------------------------------------------------------------------------
# Redis Sentinel Configuration
# -----------------------------------------------------------------------------
REDIS_SENTINEL_HOSTS=localhost:26379
REDIS_SENTINEL_MASTER_NAME=mymaster
REDIS_SENTINEL_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=30

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SENTINEL_ENABLED=true

# -----------------------------------------------------------------------------
# Gemini LLM Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_PROJECT_ID=

# Primary models
GEMINI_MODEL_REALTIME=gemini-2.0-flash
GEMINI_MODEL_INSIGHT=gemini-1.5-pro
GEMINI_MODEL_QUERY=gemini-2.5-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# Secondary models (for rate limit fallback)
GEMINI_MODEL_REALTIME_SECONDARY=gemini-1.5-flash
GEMINI_MODEL_INSIGHT_SECONDARY=gemini-2.0-flash
GEMINI_MODEL_QUERY_SECONDARY=gemini-2.0-flash

# Local embedding fallback
LOCAL_EMBEDDING_MODEL_PATH=./models
LOCAL_EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# Ollama Configuration (Fallback #1)
# -----------------------------------------------------------------------------
# Gemini 사용 불가 시 첫 번째 fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen/qwen3-8b
#OLLAMA_MODEL=gpt-oss-safeguard-20b
OLLAMA_EMBEDDING_MODEL=text-embedding-bge-m3-ko

# -----------------------------------------------------------------------------
# Groq Configuration (PRIMARY LLM Provider with 5-key rotation)
# -----------------------------------------------------------------------------
# 5 API keys for rotation (30 RPM each = 150 RPM total capacity)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_TIMEOUT=60

# -----------------------------------------------------------------------------
# OpenAI Configuration (Fallback #3)
# -----------------------------------------------------------------------------
# Groq 사용 불가 시 세 번째 fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# BGE Embedding & Rerank Configuration
# -----------------------------------------------------------------------------
# 임베딩: bge-m3-ko (1024 차원, 한국어 최적화)
# Rerank: bge-m3-rerank (RAG 검색 결과 재정렬)

# API Configuration (Primary) - Bearer Token 인증
BGE_EMBEDDING_API_URL=
BGE_EMBEDDING_API_KEY=
BGE_RERANK_API_URL=
BGE_RERANK_API_KEY=

# Local Model Configuration (Fallback - CPU)
BGE_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
BGE_LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_LOCAL_DEVICE=cpu
BGE_LOCAL_BATCH_SIZE=32
BGE_LOCAL_MODEL_CACHE_DIR=./models

# Embedding dimensions (bge-m3-ko: 1024)
BGE_EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIER=free

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=AppReviewsAnalysis
APP_VERSION=2.0.0
TIMEZONE=Asia/Seoul

# LLM Timeouts
GEMINI_TIMEOUT=240
OLLAMA_TIMEOUT=600
GROQ_TIMEOUT=60
OPENAI_TIMEOUT=180
LLM_FALLBACK_ORDER=groq,ollama,openai

# -----------------------------------------------------------------------------
# Agent Confidence Thresholds
# -----------------------------------------------------------------------------
AGENT_SENTIMENT_THRESHOLD=0.7
AGENT_CATEGORY_THRESHOLD=0.65
AGENT_COMPLAINT_THRESHOLD=0.75
AGENT_INSIGHT_THRESHOLD=0.6
AGENT_UNIFIED_THRESHOLD=0.7
AGENT_BASE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# Ollama Advanced Configuration
# -----------------------------------------------------------------------------
OLLAMA_TOP_K=20
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_NUM_CTX=8192
OLLAMA_TOP_P=0.95

# -----------------------------------------------------------------------------
# BGE Timeouts (seconds)
# -----------------------------------------------------------------------------
BGE_EMBEDDING_TIMEOUT=30
BGE_BATCH_TIMEOUT=60
BGE_RERANK_TIMEOUT=60

# -----------------------------------------------------------------------------
# Fallback Department (Ultimate Safety)
# -----------------------------------------------------------------------------
FALLBACK_DEPT_CODE=CUSTOMER_SERVICE.CALL_CENTER
FALLBACK_DEPT_NAME=콜센터운영부
FALLBACK_DIV_CODE=CUSTOMER_SERVICE
FALLBACK_DIV_NAME=고객서비스본부
FALLBACK_DEPT_DESC=기본 고객 응대 (Ultimate Fallback)

# -----------------------------------------------------------------------------
# Word cloud (optional): path to mecab-ko-dic. Empty = MeCab default dictionary
# -----------------------------------------------------------------------------
MECAB_KO_DIC_PATH=

# -----------------------------------------------------------------------------
# Word Cloud
# -----------------------------------------------------------------------------
# 한글 폰트 파일 경로 (저장소에 폰트를 포함하지 않음). 비우면 시스템 기본 경로 탐색
KOREAN_FONT_PATH=
