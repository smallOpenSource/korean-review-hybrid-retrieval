@startuml
title 스케줄러 실행 흐름도 (Scheduler Execution Flow)
footer Generated by Gemini Agent
!theme plain

' LLM 호출 강조 스타일 정의
skinparam activity {
  BackgroundColor<<LLM>> LightSalmon
  BorderColor<<LLM>> Red
}

start

:명령어 실행 (python -m scheduler.main);

if (실행 옵션 == --run-pipeline) then (Yes)
  note right
    전체 데이터 파이프라인
    순차 실행 (1회)
  end note
  
  partition "1. 데이터 수집 (Collection)" {
    :Google Play Store API 연결;
    :앱 목록 조회 (Apps Config);
    :우선순위별(High->Mid->Low) 순차 수집;
    :신규 리뷰 DB 저장;
  }
  
  partition "2. 데이터 분석 (Analysis)" {
    :미분석 리뷰 조회 (DB);
    while (데이터 존재?) is (Yes)
      :배치 단위 처리 (Batch Processing);
      
      :SentimentAgent (감성 분석)<<LLM>>;
      note right: <color:Red>LLM API Call</color>\n(Gemini Pro)
      
      :CategoryAgent (카테고리 분류)<<LLM>>;
      note right: <color:Red>LLM API Call</color>\n(Gemini Pro)
      
      :ComplaintAgent (민원 탐지)<<LLM>>;
      note right: <color:Red>LLM API Call</color>\n(Gemini Pro)
      
      :분석 결과 병합 및 DB 저장;
    endwhile (No)
  }
  
  partition "3. 동기화 (Sync)" {
    :App Metadata 캐싱 (AppService);
    :미동기화 리뷰 조회 (DB);
    :OpenSearch 문서 변환 (ReviewDocument);
    :Bulk Indexing (app_reviews 인덱스);
    :DB 동기화 상태 업데이트;
  }
  
  partition "4. 시각화 (Visualization)" {
    :분석된 데이터 조회 (OpenSearch);
    :워드클라우드 이미지 생성;
    :이미지 파일 저장;
  }

elseif (실행 옵션 == --run-once <JOB>) then (Yes)
  note right
    특정 작업 1회 실행
    (디버깅/수동)
  end note
  
  if (JOB == collect_*) then (Yes)
    :리뷰 수집 수행;
    stop
  endif
  
  if (JOB == analyze) then (Yes)
    :리뷰 분석 수행;
    note right: <color:Red>LLM API Call</color>\n(Agents)
    stop
  endif
  
  if (JOB == sync_to_opensearch) then (Yes)
    :동기화 수행;
    stop
  endif
  
  if (JOB == wordcloud) then (Yes)
    :워드클라우드 생성;
    stop
  endif
  
  :에러 출력;
  stop

elseif (실행 옵션 == --validate) then (Yes)
  :설정 파일 로드;
  :유효성 검증 및 출력;

else (Daemon Mode)
  note right
    데몬 모드
    (백그라운드 상시 실행)
  end note
  
  :APScheduler 초기화;
  :Job 등록 (scheduler_config.yaml);
  
  partition "Background Jobs" {
    :1. Collection Job (주기적 실행);
    :2. Analysis Job (1시간 간격);
    note right: <color:Red>LLM API Usage</color>
    :3. Sync Job (5분 간격);
    :4. WordCloud Job (매일 03:00);
  }
  :이벤트 루프 실행 (Forever);
endif

stop
@enduml
